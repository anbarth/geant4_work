# Interactive session:  ./sim
/run/initialize

/vis/open OGL 800x600
/vis/viewer/set/viewpointVector 1 -1 0.5
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/autoRefresh true

# The film is only 50 um thick; zoom in to see the layers, e.g.:
# (the water slab below is 100 mm thick; hide it with /vis/geometry/set/visibility Water 0 false)
# /vis/viewer/zoomTo 10
# /vis/viewer/set/viewpointVector 1 -1 0.3
# Print the volume hierarchy:
# /vis/ASCIITree/verbose 4
# /vis/drawTree

/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts false
/vis/scene/endOfEventAction accumulate 50

# Then try:  /run/beamOn 20
